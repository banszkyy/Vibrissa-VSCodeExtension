{
    "name": "bblang",
    "description": "Extension for Vibrissa",
    "author": "Bánszky",
    "version": "0.1.0",
    "displayName": "Vibrissa",
    "private": true,
    "preview": true,
    "engines": {
        "vscode": "^1.88.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Debuggers"
    ],
    "keywords": [
        "vibrissa",
        "meow",
        "vi",
        "banszky"
    ],
    "pricing": "Free",
    "publisher": "banszky",
    "repository": {
        "type": "git",
        "url": "https://github.com/banszkyy/Vibrissa-VSCodeExtension"
    },
    "markdown": "github",
    "icon": "icons/extension.png",
    "homepage": "https://github.com/banszkyy/Vibrissa-VSCodeExtension",
    "galleryBanner": {
        "color": "#2d1d37",
        "theme": "dark"
    },
    "main": "./out/extension",
    "contributes": {
        "configuration": {
            "title": "Vibrissa",
            "type": "object",
            "properties": {
                "vibrissa.server.path": {
                    "type": "string",
                    "description": "Path of the language server binary",
                    "scope": "machine-overridable"
                },
                "vibrissa.runtime.path": {
                    "type": "string",
                    "description": "Path of the runtime binary",
                    "scope": "machine-overridable"
                },
                "vibrissa.debug.server.path": {
                    "type": "string",
                    "description": "Path of the debugger host binary",
                    "scope": "machine-overridable"
                },
                "vibrissa.debug.server.log": {
                    "type": "string",
                    "description": "File path to save debugger host logs",
                    "scope": "machine-overridable"
                }
            }
        },
        "languages": [
            {
                "id": "vibrissa",
                "aliases": [
                    "Vibrissa",
                    "vi"
                ],
                "extensions": [
                    ".vi"
                ],
                "configuration": "./langs/meow.json",
                "icon": {
                    "dark": "./icons/files/meow.svg",
                    "light": "./icons/files/meow.svg"
                }
            },
            {
                "id": "vibrissa-test-result",
                "aliases": [],
                "extensions": [
                    ".result"
                ],
                "icon": {
                    "dark": "./icons/files/meow-result.svg",
                    "light": "./icons/files/meow-result.svg"
                }
            },
            {
                "id": "vibrissa-il",
                "aliases": [
                    "bbil"
                ],
                "extensions": [
                    ".bbil"
                ],
                "icon": {
                    "dark": "./icons/files/meow-il.svg",
                    "light": "./icons/files/meow-il.svg"
                }
            },
            {
                "id": "vibrissa-notebook",
                "aliases": [],
                "extensions": [
                    ".bbnb"
                ],
                "icon": {
                    "dark": "./icons/files/meow-notebook.svg",
                    "light": "./icons/files/meow-notebook.svg"
                }
            },
            {
                "id": "vibrissa-config",
                "aliases": [],
                "filenames": [
                    "vi.conf"
                ],
                "icon": {
                    "dark": "./icons/files/meow-config.svg",
                    "light": "./icons/files/meow-config.svg"
                }
            },
            {
                "id": "msil",
                "aliases": [],
                "extensions": [
                    ".il"
                ],
                "icon": {
                    "dark": "./icons/files/msil.svg",
                    "light": "./icons/files/msil.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "vibrissa",
                "scopeName": "source.vi",
                "path": "./syntax/meow.json"
            },
            {
                "language": "vibrissa-test-result",
                "scopeName": "source.result",
                "path": "./syntax/meow-test-result.json"
            },
            {
                "language": "vibrissa-il",
                "scopeName": "source.bbil",
                "path": "./syntax/meow-il.json"
            },
            {
                "language": "msil",
                "scopeName": "source.il",
                "path": "./syntax/msil.json"
            }
        ],
        "snippets": [
            {
                "language": "vibrissa",
                "path": "./snippets/meow.json"
            },
            {
                "language": "vibrissa-test-result",
                "path": "./snippets/meow-test-result.json"
            }
        ],
        "commands": [
            {
                "command": "vibrissa.debugEditorContents",
                "category": "Vibrissa",
                "title": "Debug File",
                "enablement": "!inDebugMode",
                "icon": "$(debug-alt)",
                "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
            },
            {
                "command": "vibrissa.profileEditorContents",
                "category": "Vibrissa",
                "title": "Profile File",
                "enablement": "!inDebugMode",
                "icon": "$(flame)",
                "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
            },
            {
                "command": "vibrissa.executeEditorContents",
                "category": "Vibrissa",
                "title": "Run File",
                "shortTitle": "Run File",
                "icon": "$(run)",
                "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
            },
            {
                "command": "vibrissa.update",
                "category": "Vibrissa",
                "title": "Update Binaries",
                "when": "isWorkspaceTrusted && !virtualWorkspace"
            },
            {
                "command": "vibrissa.languageServer.restart",
                "category": "Vibrissa",
                "title": "Restart Language Server",
                "when": "isWorkspaceTrusted"
            },
            {
                "command": "vibrissa.profiling.start",
                "category": "Vibrissa",
                "title": "Start profiling active debug session",
                "when": "isWorkspaceTrusted && inDebugMode && debugType == 'vibrissa'",
                "icon": "$(flame)",
                "shortTitle": "Start profiling"
            },
            {
                "command": "vibrissa.profiling.stop",
                "category": "Vibrissa",
                "title": "Stop profiling active debug session",
                "when": "isWorkspaceTrusted && inDebugMode && debugType == 'vibrissa'",
                "icon": "$(flame)",
                "shortTitle": "Stop profiling"
            },
            {
                "command": "vibrissa.recompile",
                "category": "Vibrissa",
                "title": "Recompile",
                "when": "isWorkspaceTrusted"
            }
        ],
        "breakpoints": [
            {
                "language": "vibrissa",
                "when": "!virtualWorkspace"
            }
        ],
        "debuggers": [
            {
                "type": "vibrissa",
                "languages": [
                    "vibrissa"
                ],
                "label": "Vibrissa Debug",
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Absolute path to a text file.",
                                "default": "${workspaceFolder}/${command:AskForProgramName}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Automatically stop after launch.",
                                "default": true
                            },
                            "noDebug": {
                                "type": "boolean",
                                "description": "Launch the session in no-debug mode",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "vibrissa",
                        "request": "launch",
                        "name": "Ask for file name",
                        "program": "${workspaceFolder}/${command:AskForProgramName}",
                        "stopOnEntry": true
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Vibrissa Debug: Launch",
                        "description": "A new configuration for 'debugging' a user selected file.",
                        "body": {
                            "type": "vibrissa",
                            "request": "launch",
                            "name": "Ask for file name",
                            "program": "^\"\\${workspaceFolder}/\\${command:AskForProgramName}\"",
                            "stopOnEntry": true
                        }
                    }
                ],
                "when": "!virtualWorkspace"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "vibrissa.executeEditorContents",
                    "group": "vibrissa",
                    "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
                }
            ],
            "editor/title/context": [
                {
                    "command": "vibrissa.executeEditorContents",
                    "group": "vibrissa",
                    "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
                }
            ],
            "editor/title/run": [
                {
                    "command": "vibrissa.debugEditorContents",
                    "group": "vibrissa",
                    "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
                },
                {
                    "command": "vibrissa.profileEditorContents",
                    "group": "vibrissa",
                    "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
                },
                {
                    "command": "vibrissa.executeEditorContents",
                    "group": "vibrissa",
                    "when": "isWorkspaceTrusted && resourceLangId == vibrissa && !virtualWorkspace"
                }
            ],
            "debug/toolBar": [
                {
                    "command": "vibrissa.profiling.start",
                    "when": "isWorkspaceTrusted && debugType == 'vibrissa' && !vibrissa.isProfiling",
                    "group": "navigation"
                },
                {
                    "command": "vibrissa.profiling.stop",
                    "when": "isWorkspaceTrusted && debugType == 'vibrissa' && vibrissa.isProfiling",
                    "group": "navigation"
                }
            ]
        },
        "notebooks": [
            {
                "type": "vibrissa-notebook",
                "displayName": "Vibrissa Notebook",
                "selector": [
                    {
                        "filenamePattern": "*.bbnb"
                    }
                ]
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "vibrissa",
                "scopes": {
                    "keyword.meow": [
                        "keyword"
                    ]
                }
            }
        ],
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Debugging and rich language features will be disabled in restricted mode"
        }
    },
    "scripts": {
        "compile": "./clean && tsc --project ./",
        "package": "vsce package --out VibrissaExtension.vsix",
        "list": "vsce ls"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/node": "^26.0.1",
        "@types/vscode": "^1.88.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "@vscode/vsce": "^3.9.2",
        "typescript": "^6.0.3",
        "vsce": "^2.15.0"
    },
    "dependencies": {
        "adm-zip": "^0.6.0",
        "vscode-jsonrpc": "^8.2.1",
        "vscode-languageclient": "^10.0.1"
    },
    "capabilities": {
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "Debugging and some language features are not avaliable in virtual workspaces"
        }
    }
}