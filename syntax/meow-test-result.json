{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "patterns": [
    {
      "include": "#escaped"
    },
    {
      "include": "#hash"
    }
  ],
  "repository": {
    "escaped": {
      "captures": {
        "1": {
          "name": "constant.character.escape"
        }
      },
      "match": "(\\.)"
    },
    "hash": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword"
            },
            "2": {
              "name": "constant.numeric"
            }
          },
          "match": "(#exitcode)\\s+(-?\\d+)\\n"
        },
        {
          "captures": {
            "1": {
              "name": "keyword"
            },
            "2": {
              "name": "string.unquoted"
            },
            "3": {
              "patterns": [
                {
                  "captures": {
                    "1": {
                      "name": "punctuation"
                    }
                  },
                  "match": "(=>)"
                },
                {
                  "captures": {
                    "1": {
                      "name": "entity.name.type"
                    },
                    "2": {
                      "name": "punctuation"
                    },
                    "3": {
                      "name": "constant.numeric"
                    }
                  },
                  "match": "(i8|i16|i32)(:)(-?\\d+)"
                },
                {
                  "captures": {
                    "1": {
                      "name": "entity.name.type"
                    },
                    "2": {
                      "name": "punctuation"
                    },
                    "3": {
                      "name": "constant.numeric"
                    }
                  },
                  "match": "(f32)(:)(-?(\\d+(\\.\\d+)?))"
                }
              ]
            }
          },
          "match": "(#exposed)\\s+(\\w+)(.*)\\n"
        },
        {
          "captures": {
            "1": {
              "name": "invalid"
            }
          },
          "match": "(#.*)\n"
        }
      ]
    }
  },
  "fileTypes": [
    "vibrissa-test-result"
  ],
  "name": "Vibrissa Test Result Language",
  "scopeName": "source.result"
}