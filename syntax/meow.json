{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "patterns": [
    {
      "include": "#hover-popup"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#using"
    },
    {
      "include": "#alias-definition"
    },
    {
      "include": "#enum-definition"
    },
    {
      "include": "#struct-definition"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#any-statement"
    },
    {
      "include": "#scope"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "scope": {
      "begin": "{",
      "end": "}",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#comment-block"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#any-statement"
        },
        {
          "include": "#scope"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "comment"
            },
            "2": {
              "name": "comment"
            }
          },
          "match": "(#if)\\s *([a-zA-Z_@]+[a-zA-Z0-9_@]*)"
        },
        {
          "captures": {
            "1": {
              "name": "comment"
            },
            "2": {
              "name": "comment"
            }
          },
          "match": "(#else)"
        },
        {
          "captures": {
            "1": {
              "name": "comment"
            }
          },
          "match": "(#endif)"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "captures": {
            "1": {
              "name": "keyword"
            }
          },
          "match": "\\b(void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "entity.name.type"
            }
          },
          "match": "\\b(\\w+)\\b"
        },
        {
          "captures": {
            "1": {
              "name": "punctuation"
            }
          },
          "match": "(\\<|\\>)"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "literal": {
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#number"
        }
      ]
    },
    "any-statement": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#comment-block"
        },
        {
          "include": "#as"
        },
        {
          "include": "#flow-control-statement"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#local-definition"
        },
        {
          "include": "#field-access"
        },
        {
          "include": "#literal"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "hover-popup": {
      "match": "^\\([a-z]+\\)(?= )",
      "name": "punctuation"
    },
    "flow-control-statement": {
      "captures": {
        "1": {
          "name": "keyword.control"
        }
      },
      "match": "\\b(return|crash|if|else|while|for|break)\\b"
    },
    "comment": {
      "match": "\\/\\/[^\\n]*\\n",
      "name": "comment.line.double-slash"
    },
    "comment-block": {
      "patterns": [
        {
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end"
            }
          },
          "name": "comment.block",
          "patterns": [
            {
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment"
                }
              },
              "match": "^[ \\t]*(\\*)(?!/)"
            }
          ]
        },
        {
          "match": "\\*/.*\\n",
          "name": "invalid.illegal.stray-comment-end"
        }
      ]
    },
    "number": {
      "match": "(\\.[0-9]+f?\\b|\\b[0-9]+f?\\b|\\b0x[0-9a-fA-F_]+\\b|\\b0b[01_]+\\b|\\b[0-9]e[0-9]f?\\b)",
      "name": "constant.numeric"
    },
    "struct-definition": {
      "captures": {
        "1": {
          "name": "keyword"
        },
        "2": {
          "name": "entity.name.type"
        }
      },
      "match": "(struct)[\\s]+((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)"
    },
    "alias-definition": {
      "captures": {
        "1": {
          "name": "keyword"
        },
        "2": {
          "name": "entity.name.type"
        }
      },
      "match": "(alias)\\s+((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)\\s+"
    },
    "enum-definition": {
      "captures": {
        "1": {
          "name": "keyword"
        },
        "2": {
          "name": "entity.name.type"
        },
        "4": {
          "name": "punctuation"
        },
        "5": {
          "patterns": [
            {
              "include": "#type"
            }
          ]
        }
      },
      "match": "(enum)\\s+((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)(\\s*(:)\\s*((?!(?:struct|using|alias|enum|temp|this|const|inline|private|export|as|new|delete|sizeof)\\b)([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*)|([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*\\<[\\w,\\s]*\\>)))?"
    },
    "using": {
      "captures": {
        "1": {
          "name": "keyword.control"
        },
        "2": {
          "name": "string"
        }
      },
      "match": "\\b(using)\\s+([a-zA-Z0-9_\\.]+)"
    },
    "keyword": {
      "captures": {
        "1": {
          "name": "keyword"
        }
      },
      "match": "\\b(struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b"
    },
    "function-call": {
      "captures": {
        "1": {
          "name": "entity.name.function"
        }
      },
      "match": "\\b((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)\\b\\s*(?=\\()"
    },
    "function-definition": {
      "patterns": [
        {
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#type"
                }
              ]
            },
            "2": {
              "name": "entity.name.function"
            }
          },
          "match": "((?!(?:struct|using|alias|enum|temp|this|const|inline|private|export|as|new|delete|sizeof)\\b)([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*)|([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*\\<[\\w,\\s]*\\>))\\s+((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)\\s*(?=\\()"
        },
        {
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#type"
                }
              ]
            },
            "2": {
              "name": "entity.name.function"
            },
            "3": {
              "patterns": [
                {
                  "captures": {
                    "1": {
                      "name": "entity.name.type"
                    }
                  },
                  "match": "\\b(\\w+)\\b"
                }
              ]
            }
          },
          "match": "((?!(?:struct|using|alias|enum|temp|this|const|inline|private|export|as|new|delete|sizeof)\\b)([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*)|([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*\\<[\\w,\\s]*\\>))\\s+((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)\\s*(<.*>)\\s*(?=\\()"
        }
      ]
    },
    "local-definition": {
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#type"
            }
          ]
        }
      },
      "match": "\\b((?!(?:struct|using|alias|enum|temp|this|const|inline|private|export|as|new|delete|sizeof)\\b)([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*)|([a-zA-Z_@]+[a-zA-Z0-9_@\\*\\[\\]]*\\<[\\w,\\s]*\\>))\\s+((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)\\b"
    },
    "field-access": {
      "captures": {
        "1": {
          "name": "entity.name.variable"
        }
      },
      "match": "\\.\\s*((?!(?:struct|using|alias|enum|temp|this|const|inline|void|any|u8|i8|u16|i16|u32|i32|u64|i64|f32|private|export|as|new|delete|sizeof)\\b)[a-zA-Z_@]+[a-zA-Z0-9_@]*)\\b"
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double",
          "patterns": [
            {
              "include": "#string-escaped-char"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single",
          "patterns": [
            {
              "include": "#string-escaped-char"
            }
          ]
        }
      ]
    },
    "string-escaped-char": {
      "patterns": [
        {
          "match": "(?x)\\\\(\\\\|[ntr\\\"e]|0|(u[0-9a-fA-F]{4}))",
          "name": "constant.character.escape"
        },
        {
          "match": "\\\\(u[0-9a-zA-Z]{4}|.)",
          "name": "invalid.illegal.unknown-escape"
        }
      ]
    },
    "operator": {
      "captures": {
        "1": {
          "name": "keyword.operator"
        }
      },
      "match": "(<|>|<=|>=|==|!=|!|-|\\+|\\*|\\/|&|\\+=|-=|\\*=|\\/=|&=|\\^=|\\^|\\|=|%|<<|>>|&&|\\|\\||~|\\+\\+|--|=)"
    },
    "punctuation": {
      "captures": {
        "1": {
          "name": "punctuation"
        }
      },
      "match": "(;|:|,|\\(|\\)|\\[|\\]|=>|\\.)"
    }
  },
  "fileTypes": [
    ".vi"
  ],
  "name": "Vibrissa Language",
  "scopeName": "source.vi"
}